package org.firstinspires.ftc.teamcode;
import static org.firstinspires.ftc.teamcode.Libs.JCLibs.clamp;
import static org.firstinspires.ftc.teamcode.Libs.JCLibs.lerp;
import static org.firstinspires.ftc.teamcode.Libs.JCLibs.round;


import com.qualcomm.robotcore.eventloop.opmode.TeleOp;

import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.Gamepad;
import com.qualcomm.robotcore.hardware.HardwareMap;
import com.qualcomm.robotcore.hardware.Servo;

import org.firstinspires.ftc.teamcode.Libs.Classes.Vector3;
import org.firstinspires.ftc.teamcode.Libs.JCLibs;
import org.firstinspires.ftc.teamcode.Libs.PlayOpMode;

import kotlin.math.UMathKt;

@TeleOp(name="PostComp", group="demo")
public class PostComp extends PlayOpMode {
    drivetrain Drive = new drivetrain();
    
    Turret Arm = new Turret();
    HardwareMap map;

    double Num;
    double Num2;


    double am;
    double position;
    int ArmPos;
    double lsx_lerped = 0;
    double rsx_lerped = 0;
    double lsy_lerped = 0;
    int start= 0;
    int Value;

    double CPR = 2786.2;
    double CurrentAngle;
    double NewAngle;
    double NewP;
    int NewPR;
    //Controller
    Gamepad current;
    Gamepad previous;
    double lsx;
    double rsx;
    double lsy;
    boolean up;
    boolean down;
    boolean left;
    boolean right;
    double RT;
    double LT;
    boolean a;
    boolean b;
    boolean x;
    boolean y;
    //
    int DTGear;
    int TGear;
    String DriveTrainGear;
    String TurretGear;
    String TStatus;
    double DTSpeed;
    double TSpeed;
    boolean Lock;
    Servo wheel;
    Servo yaw;
    Servo pitch;

    @Override
    protected void preinitilize() {
        isTeleOp = true;

    }

    @Override
    protected void initialize() {
        map = hardwareMap;
        Drive.init(map);
        Arm.init(map);
        Drive.initializeMotor(Drive.LB, DcMotor.Direction.FORWARD);
        Drive.initializeMotor(Drive.LF, DcMotor.Direction.FORWARD);
        Drive.initializeMotor(Drive.RF, DcMotor.Direction.FORWARD);
        Drive.initializeMotor(Drive.RB, DcMotor.Direction.FORWARD);
        DTGear = 0;
        TGear = 0;
        TStatus =" Locked";
        current = new Gamepad();
        previous = new Gamepad();
        yaw = hardwareMap.get(Servo.class, "yaw");
        wheel = hardwareMap.get(Servo.class, "wheel");
        pitch = hardwareMap.get(Servo.class,"pitch");
        yaw.setPosition(0);
        pitch.setPosition(0);

    }

    void Controller(Gamepad gamepaD){

        //Thump sticks
        lsy = gamepaD.left_stick_y;
        rsx = -gamepaD.right_stick_x;
        lsx = gamepaD.left_stick_x;

        //Dpad
        up = gamepaD.dpad_up;
        down = gamepaD.dpad_down;
        left = gamepaD.dpad_left;
        right = gamepaD.dpad_right;

        //Face buttons
        a = gamepaD.a;
        b = gamepaD.b;
        x = gamepaD.x;
        y = gamepaD.y;
        RT = gamepaD.right_trigger;
        LT = gamepaD.left_trigger;
        previous.copy(current);


        // Store the gamepad values from this loop iteration in
        // currentGamepad1/2 to be used for the entirety of this loop iteration.
        // This prevents the gamepad values from changing between being
        // used and stored in previousGamepad1/2.
        current.copy(gamepaD);

    }
    void SwitchCase(){
        switch (DTGear){
            case 0:
                DTSpeed = 0;
                DriveTrainGear = "0-Locked";
                break;
            case 1:
                DTSpeed = 0.4;
                DriveTrainGear = "1-Slow";
                break;
            case 2:
                DTSpeed = 0.6;
                DriveTrainGear = "2-Medium";
                break;
            case 3:
                DTSpeed = 1;
                DriveTrainGear ="3-Fast";
                break;
        }
        switch (TGear){
            case 0:
                TSpeed = 0;
                TurretGear = "0-Locked";
                break;
            case 1:
                TSpeed = 0.4;
                TurretGear = "1-Slow";
                break;
            case 2:
                TSpeed = 0.6;
                TurretGear = "2-Medium";
                break;
            case 3:
                TSpeed = 0.8;
                TurretGear ="3-Fast";
                break;
        }
    }
    void TurretLock()
    {
        switch (Lock ? 1:0)
        {
            case 0:
                TStatus = "Unlocked";
                if(left) {

                    Num = 1;
                    am +=  0.01*Num;
                    Arm.Wheel.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    Arm.Wheel.setPower(TSpeed);
                }else if (right) {

                    Num = -1;
                    am +=  0.01*Num;
                    Arm.Wheel.setMode(DcMotor.RunMode.RUN_TO_POSITION);
                    Arm.Wheel.setPower(TSpeed);

                }else {
                    Num = 0;
                    am +=  0.01*Num;
                    Arm.Wheel.setPower(1);
                }
                break;
            case 1:
                TStatus ="Locked";
                if(left)
                {//positive
                   if(x){
                       am= 0.25;
                       Arm.Wheel.setPower(TSpeed);
                   }
                    if(y){
                        am= 0.50;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if(b){
                        am= 0.75;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if(a){
                        am= 0.100;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if (gamepad1.share){
                        am= 0;
                        Arm.Wheel.setPower(TSpeed);
                    }
                }else if(right){
                    if(x){
                        am= -0.25;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if(y){
                        am= -0.50;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if(b){
                        am= -0.75;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if(a){
                        am= -0.100;
                        Arm.Wheel.setPower(TSpeed);
                    }
                    if (gamepad1.share){
                        am= 0;
                        Arm.Wheel.setPower(TSpeed);
                    }
                }
                break;

        }
    }

    @Override
    protected void run(double dt) throws InterruptedException {
       Controller(gamepad1);
       SwitchCase();
        lsx_lerped = lerp(lsx_lerped, lsx, 0.9);
        rsx_lerped = lerp(rsx_lerped, rsx, 0.9);
        lsy_lerped = lerp(lsy_lerped, lsy, 0.9);
        Drive.move(lsy_lerped * DTSpeed, rsx_lerped * DTSpeed, lsx_lerped * DTSpeed);


        // Get the current position of the motor
         position = Arm.Wheel.getCurrentPosition();
         ArmPos = Arm.Lever.getCurrentPosition();
        double revolutions = position/CPR;


       double word = JCLibs.clamp(am,-1,1);
       DTGear = (int)JCLibs.clamp(DTGear,0,3);
       TGear = (int) JCLibs.clamp(TGear,0,3);
        CurrentAngle = revolutions * 360;
        NewAngle = lerp(0,100,word);
        double nr = NewAngle/360;
        NewP = nr*CPR;
        NewPR =(int) round(NewP,0);

        double rpower = LT - RT;
        Arm.Arm.setPower(rpower);
        telemetry.addData("Current Angle: ",CurrentAngle);
        telemetry.addData("New Angle",NewAngle);
        telemetry.addData("am",am);
        telemetry.addData("word",word);
        telemetry.addData("New Position",NewPR);
        telemetry.addData("Turret",TStatus);
        telemetry.addData("Drive Train Gear",DriveTrainGear);
        telemetry.addData("Turret Gear",TurretGear);
        telemetry.addData("Lock",Lock);
        telemetry.addData("Turret Motor Speed ",TSpeed);
        telemetry.addData("Left Back",Drive.LB.getPower());
        telemetry.addData("Left Front",Drive.LF.getPower());
        telemetry.addData("Right Back",Drive.RB.getPower());
        telemetry.addData("Right Back",Drive.RB.getPower());
        telemetry.addData(" Yaw Position: ", yaw.getPosition());

        telemetry.addData(" Pitch Position: ", pitch.getPosition());
        telemetry.update();



        if (up) {
            Num2= 1;
            Arm.Lever.setPower(1);
            Arm.Lever.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        }else if (down) {
            Num2=-1;
            Arm.Lever.setPower(1);
            Arm.Lever.setMode(DcMotor.RunMode.RUN_TO_POSITION);

        } else { Num2 = 0;}





        if(current.left_stick_button && !previous.left_stick_button){
           DTGear +=1;
        }
        if(current.right_stick_button && !previous.right_stick_button){
          DTGear -= 1;
        }
        if(current.left_bumper && !previous.left_bumper){
            TGear +=1;
        }
        if(current.right_bumper && !previous.right_bumper){
            TGear -= 1;
        }
        if((current.left_stick_button && !previous.left_stick_button)&&(current.right_stick_button && !previous.right_stick_button)&&(current.left_bumper && !previous.left_bumper)&&(current.right_bumper && !previous.right_bumper))
        {
            Lock =! Lock;
        }
        TurretLock();
        Arm.Wheel.setTargetPosition(NewPR);
        Arm.Lever.setTargetPosition(ArmPos += (int) (50*Num2));

        if(gamepad2.cross){
            wheel.setPosition(0);
            wheel.setDirection(Servo.Direction.FORWARD);
        }

        if(gamepad2.square){
            wheel.setPosition(1);
            wheel.setDirection(Servo.Direction.FORWARD);
        }

        if(Math.abs(gamepad2.right_stick_y)>.2){
            pitch.setPosition(gamepad2.right_stick_y);
        }

        if(Math.abs(gamepad2.right_stick_x)>.2){
            yaw.setPosition(gamepad2.right_stick_x);
        }



    }
}
